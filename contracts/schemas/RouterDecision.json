{
  "$defs": {
    "Dispatch": {
      "additionalProperties": false,
      "description": "One provisional resource assignment for one need (CR-003).",
      "properties": {
        "need": {
          "$ref": "#/$defs/Need"
        },
        "resource_kind": {
          "enum": [
            "boat",
            "ambulance",
            "shelter",
            "welfare_point"
          ],
          "title": "Resource Kind",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "status": {
          "enum": [
            "provisional",
            "unfilled"
          ],
          "title": "Status",
          "type": "string"
        },
        "same_district": {
          "default": false,
          "title": "Same District",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "need",
        "resource_kind",
        "status"
      ],
      "title": "Dispatch",
      "type": "object"
    },
    "Need": {
      "enum": [
        "rescue",
        "medical",
        "water",
        "food",
        "shelter",
        "evacuation",
        "power",
        "information",
        "aid_payment"
      ],
      "title": "Need",
      "type": "string"
    },
    "NextAction": {
      "enum": [
        "ask_next_question",
        "create_provisional_dispatch",
        "escalate_to_supervisor",
        "finalize_case",
        "request_more_evidence"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "Outcome": {
      "additionalProperties": false,
      "description": "One shape for both systems. reasoning is set by System 2 only.",
      "properties": {
        "system": {
          "$ref": "#/$defs/System"
        },
        "outcome": {
          "enum": [
            "fast_route",
            "reasoned_recommendation",
            "escalate"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "needs": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Needs",
          "type": "array"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "next_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Question"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        },
        "escalate": {
          "title": "Escalate",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "system",
        "outcome",
        "priority",
        "needs",
        "route",
        "confidence",
        "reason",
        "requires_human",
        "escalate"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Route": {
      "enum": [
        "rescue_coordination",
        "medical_response",
        "welfare_distribution",
        "shelter_placement",
        "aid_caseworker",
        "information_only",
        "duplicate_merge",
        "supervisor_escalation"
      ],
      "title": "Route",
      "type": "string"
    },
    "System": {
      "enum": [
        "system_1",
        "system_2"
      ],
      "title": "System",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "next_action": {
      "$ref": "#/$defs/NextAction"
    },
    "final_priority": {
      "$ref": "#/$defs/Priority"
    },
    "final_route": {
      "$ref": "#/$defs/Route"
    },
    "requires_human": {
      "title": "Requires Human",
      "type": "boolean"
    },
    "source_outcomes": {
      "items": {
        "$ref": "#/$defs/Outcome"
      },
      "title": "Source Outcomes",
      "type": "array"
    },
    "policy_notes": {
      "items": {
        "type": "string"
      },
      "title": "Policy Notes",
      "type": "array"
    },
    "dispatches": {
      "items": {
        "$ref": "#/$defs/Dispatch"
      },
      "title": "Dispatches",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "next_action",
    "final_priority",
    "final_route",
    "requires_human",
    "source_outcomes"
  ],
  "title": "RouterDecision",
  "type": "object"
}

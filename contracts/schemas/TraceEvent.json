{
  "$defs": {
    "Need": {
      "enum": [
        "rescue",
        "medical",
        "water",
        "food",
        "shelter",
        "evacuation",
        "power",
        "information",
        "aid_payment"
      ],
      "title": "Need",
      "type": "string"
    },
    "Outcome": {
      "additionalProperties": false,
      "description": "One shape for both systems. reasoning is set by System 2 only.",
      "properties": {
        "system": {
          "$ref": "#/$defs/System"
        },
        "outcome": {
          "enum": [
            "fast_route",
            "reasoned_recommendation",
            "escalate"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "needs": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Needs",
          "type": "array"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "next_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Question"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        },
        "escalate": {
          "title": "Escalate",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "system",
        "outcome",
        "priority",
        "needs",
        "route",
        "confidence",
        "reason",
        "requires_human",
        "escalate"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Route": {
      "enum": [
        "rescue_coordination",
        "medical_response",
        "welfare_distribution",
        "shelter_placement",
        "aid_caseworker",
        "information_only",
        "duplicate_merge",
        "supervisor_escalation"
      ],
      "title": "Route",
      "type": "string"
    },
    "System": {
      "enum": [
        "system_1",
        "system_2"
      ],
      "title": "System",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "stage": {
      "enum": [
        "gateway",
        "enrich",
        "memory",
        "system_1",
        "system_2",
        "mubit_chat",
        "router",
        "memory_write"
      ],
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "tokens_in": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens In"
    },
    "tokens_out": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Out"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "case_id",
    "stage",
    "started_at",
    "latency_ms"
  ],
  "title": "TraceEvent",
  "type": "object"
}

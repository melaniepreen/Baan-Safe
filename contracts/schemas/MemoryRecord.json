{
  "$defs": {
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "correction_id": {
          "minLength": 1,
          "title": "Correction Id",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "corrected_by": {
          "enum": [
            "operator",
            "supervisor",
            "caseworker"
          ],
          "title": "Corrected By",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "old_value": {
          "default": null,
          "title": "Old Value"
        },
        "new_value": {
          "default": null,
          "title": "New Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "case_id",
        "corrected_by",
        "field",
        "reason",
        "created_at"
      ],
      "title": "Correction",
      "type": "object"
    },
    "ExtractedFields": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "location_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Confidence"
        },
        "people_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "People Count"
        },
        "vulnerable": {
          "items": {
            "type": "string"
          },
          "title": "Vulnerable",
          "type": "array"
        },
        "medical": {
          "default": false,
          "title": "Medical",
          "type": "boolean"
        },
        "danger": {
          "items": {
            "type": "string"
          },
          "title": "Danger",
          "type": "array"
        },
        "needs": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Needs",
          "type": "array"
        }
      },
      "title": "ExtractedFields",
      "type": "object"
    },
    "Need": {
      "enum": [
        "rescue",
        "medical",
        "water",
        "food",
        "shelter",
        "evacuation",
        "power",
        "information",
        "aid_payment"
      ],
      "title": "Need",
      "type": "string"
    },
    "NextAction": {
      "enum": [
        "ask_next_question",
        "create_provisional_dispatch",
        "escalate_to_supervisor",
        "finalize_case",
        "request_more_evidence"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "Outcome": {
      "additionalProperties": false,
      "description": "One shape for both systems. reasoning is set by System 2 only.",
      "properties": {
        "system": {
          "$ref": "#/$defs/System"
        },
        "outcome": {
          "enum": [
            "fast_route",
            "reasoned_recommendation",
            "escalate"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "needs": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Needs",
          "type": "array"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "next_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Question"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        },
        "escalate": {
          "title": "Escalate",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "system",
        "outcome",
        "priority",
        "needs",
        "route",
        "confidence",
        "reason",
        "requires_human",
        "escalate"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Route": {
      "enum": [
        "rescue_coordination",
        "medical_response",
        "welfare_distribution",
        "shelter_placement",
        "aid_caseworker",
        "information_only",
        "duplicate_merge",
        "supervisor_escalation"
      ],
      "title": "Route",
      "type": "string"
    },
    "RouterDecision": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "next_action": {
          "$ref": "#/$defs/NextAction"
        },
        "final_priority": {
          "$ref": "#/$defs/Priority"
        },
        "final_route": {
          "$ref": "#/$defs/Route"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        },
        "source_outcomes": {
          "items": {
            "$ref": "#/$defs/Outcome"
          },
          "title": "Source Outcomes",
          "type": "array"
        },
        "policy_notes": {
          "items": {
            "type": "string"
          },
          "title": "Policy Notes",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "next_action",
        "final_priority",
        "final_route",
        "requires_human",
        "source_outcomes"
      ],
      "title": "RouterDecision",
      "type": "object"
    },
    "System": {
      "enum": [
        "system_1",
        "system_2"
      ],
      "title": "System",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "case_summary": {
      "title": "Case Summary",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/ExtractedFields"
    },
    "decision": {
      "$ref": "#/$defs/RouterDecision"
    },
    "outcome_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Label"
    },
    "failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "corrections": {
      "items": {
        "$ref": "#/$defs/Correction"
      },
      "title": "Corrections",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "case_id",
    "case_summary",
    "evidence",
    "decision"
  ],
  "title": "MemoryRecord",
  "type": "object"
}

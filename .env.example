# Copy to .env (gitignored). Never commit .env. `make sync` creates .env from this file
# and adds missing names without overwriting values; config/envfile.py loads it and an
# existing shell variable wins. tests/test_env_example.py checks every name the code
# reads is listed here. A line that starts with `# NAME=` is documented but not set,
# because that code has a non-empty default and an empty string would break it.
# Values below are the recommended developer setup: System 1 rules, System 2 replaying
# recorded Nemotron replies, BaanSafe's own JSONL memory store.
# Do not set MEMORY_IMPL=mubit: Mubit has no memory API and that backend is dormant
# (audit A1: a stale .env with it silently returned no memory items).

# --- Backends -----------------------------------------------------------------
# stub (fixture outcomes) | real (rules in system1/decide.py; no key needed).
S1_IMPL=real
# stub | real (Nemotron via Mubit every turn) | cache (replay S2_CACHE_PATH, Mubit only on a miss).
S2_IMPL=cache
# exact (whole payload) | case (transcript/fields/triggers only; the hosted default).
S2_CACHE_KEY=exact
# Committed replay fixture read by S2_IMPL=cache. Default fixtures/s2_cache/demo.jsonl.
S2_CACHE_PATH=
# Where a cache miss is recorded (`make record-s2-cache` sets it). Empty = record nothing.
S2_CACHE_RECORD_PATH=
# mock (fixture files, no writes) | local (own JSONL store) | mubit (dormant, do not use).
MEMORY_IMPL=local
# JSONL file for MEMORY_IMPL=local. Default var/memory.jsonl (gitignored). `make seed-memory` fills it.
MEMORY_LOCAL_PATH=
# data (shipped JSON via ingest.store) | off. Empty = data when data/processed exists, else off.
ENRICH_IMPL=
# stub only today. Sapling GPU hosting is TODO_HUMAN.
SAPLING_IMPL=
# Path to a learned overlay JSON (eval/out/rl/overlay.json). Empty = overlay off.
RL_OVERLAY=

# --- Mubit (the only LLM edge) ------------------------------------------------
# Must be api.mubit.ai or a mubit.ai subdomain; llm/client.py refuses anything else.
MUBIT_BASE_URL=https://api.mubit.ai/compat/openrouter/v1
# Blank in git. Fill locally; `make modal-secrets` pushes it to the baansafe-mubit secret.
MUBIT_API_KEY=
# Mubit console project id when it differs from memory.mubit_project (baansafe-demo).
MUBIT_PROJECT_ID=
# Dormant memory client only: a mubit.ai host that serves /v2/control. Leave empty.
MUBIT_CONTROL_URL=
# Blank on purpose. Nemotron is OpenRouter behind the Mubit gateway; there is no OpenRouter client.
OPENROUTER_API_KEY=

# --- Runtime files (defaults are gitignored repo paths; Modal uses /data/...) ---
# TraceEvent JSONL. Default traces.jsonl at the repo root.
TRACE_PATH=
# Operator correction log. Default data/processed/corrections.jsonl.
MOCK_CORRECTIONS_PATH=
# Training event log read by export and graduation. Default training/events/events.jsonl.
TRAINING_EVENTS_PATH=
# Pinned policy files written by POST /policies. Default under data/.
POLICY_PIN_DIR=
# Fine-tune registry read by GET /training. Hosted: /vol/registry.json. Empty = none.
TRAINING_REGISTRY_PATH=
# RL report read by GET /training. Default eval/out/rl/run.json; hosted /data/rl_run.json.
RL_RUN_PATH=
# Snapshots compared by `make rl-compare` and GET /training/compare (name under eval/snapshots/rl/,
# a directory, or a run.json). Defaults: 20261025T0407Z-memory-empty vs 20261025T0600Z-memory-local.
RL_COMPARE_A=
RL_COMPARE_B=
# `make eval-gate` thresholds: min SetFit held-out accuracy (default 0.85) and the RL baseline
# snapshot whose last-epoch critical_under must not be exceeded (default 20261025T0600Z-memory-local).
EVAL_GATE_S1_ACC=
EVAL_GATE_BASELINE=
# SQLite path for ingest.db. Default under data/.
BAANSAFE_DB_PATH=

# --- Data sources --------------------------------------------------------------
# GISTDA flood API key (optional; snapshots are committed).
GISTDA_API_KEY=
# Contact string sent in the User-Agent of public-source requests.
BAANSAFE_CONTACT=
# Unused: ingest/reliefweb.py sends no request. Kept so `make sync` does not re-add it.
RELIEFWEB_APPNAME=

# --- Evals ---------------------------------------------------------------------
# fixtures (the original 24) | synthetic | all for `make extract-eval`.
# EXTRACT_EVAL_SET=
# stub | synthetic for `make eval-learning`.
EVAL_LEARNING_SET=
# 1 starts the latte-bench UI from the submodule; LATTE_LIVE=1 also requires Mubit env.
LATTE_SERVE=
LATTE_LIVE=
# latte-bench live UI model names. The free reference run does not read them.
MUBIT_MODEL=
FRONTIER_MODEL=

# --- Modal / fine-tune (deploy-time only) -------------------------------------
# Hugging Face token for model downloads on Modal; synced to baansafe-hf. Blank in git.
HF_TOKEN=
# Optional bearer for the self-hosted vLLM System 2; synced to baansafe-mubit when set.
S2_SERVE_API_KEY=
# vLLM context length and fast-boot switch for infra/modal/s2_cmd.py.
# S2_MAX_MODEL_LEN=
# S2_FAST_BOOT=
# Recorded on GET /hosting; http(s) URLs of the other Modal apps. They do not replace gateway outcomes.
S1_UPSTREAM=
S2_UPSTREAM=
SAPLING_UPSTREAM=
STT_UPSTREAM=
# `make modal-finetune` inputs: sentence-transformer for SetFit, task/role, step and length caps,
# held-out file, and the dry-run output dir.
FINETUNE_S1_MODEL=
FINETUNE_TASK=
FINETUNE_ROLE=
# FINETUNE_MAX_STEPS=
# FINETUNE_MAX_LENGTH=
FINETUNE_HELDOUT=
# FINETUNE_DRY_RUN_DIR=
# Laya fine-tune runs only with LAYA_TRAIN=1 on a GPU/Modal task; LAYA_OUT is the checkpoint dir.
LAYA_TRAIN=
# LAYA_OUT=
# Alternate .env for `make modal-secrets`, and an alternate decisions.yaml for infra/modal/common.py.
BAANSAFE_ENV=
BAANSAFE_DECISIONS=
# `make sync` conflict rule: local | remote | manual. `make push MSG=...` commits first.
# SYNC_KEEP=
# MSG=

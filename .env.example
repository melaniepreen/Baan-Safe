# Copy to .env. Do not commit .env. None of these are required for the stub service.
# `make sync` creates .env from this file and can push HF/Mubit keys to Modal.
BAANSAFE_CONTACT=
GISTDA_API_KEY=
RELIEFWEB_APPNAME=
HF_TOKEN=
MUBIT_API_KEY=
MUBIT_BASE_URL=
# Blank on purpose. System 2 Nemotron is OpenRouter behind the Mubit gateway.
# There is no direct OpenRouter client. Do not put a key here.
OPENROUTER_API_KEY=
# Optional. If set, `make modal-secrets` / `make sync` put it on baansafe-mubit.
S2_SERVE_API_KEY=
# Live latte-bench UI only (`make latte-bench LATTE_LIVE=1`). The free reference does not read these.
# MUBIT_BASE_URL may be the gateway root (https://api.mubit.ai), /openai/v1, or
# /compat/openrouter/v1. The root maps onto the OpenAI prefix. A compat prefix is kept.
MUBIT_MODEL=
FRONTIER_MODEL=
S1_IMPL=real
# cache replays fixtures/s2_cache/demo.jsonl; a miss goes to Mubit only when MUBIT_* are set.
S2_IMPL=cache
# exact for local; hosted sets case (see system2/cache.py)
S2_CACHE_KEY=exact
# mock (fixture files) | local (own JSONL store at MEMORY_LOCAL_PATH, default var/memory.jsonl)
# | mubit (dormant: HANDOVER audit A1, every turn 404s and memory stays empty)
MEMORY_IMPL=local
MEMORY_LOCAL_PATH=
ENRICH_IMPL=data

# Copy to .env. Do not commit .env. None of these are required for the stub service.
BAANSAFE_CONTACT=
GISTDA_API_KEY=
RELIEFWEB_APPNAME=
MUBIT_API_KEY=
MUBIT_BASE_URL=
# Live latte-bench UI only (`make latte-bench LATTE_LIVE=1`). The free reference does not read these.
# MUBIT_BASE_URL may be the gateway root (https://api.mubit.ai). The runner maps it onto the OpenAI prefix.
MUBIT_MODEL=
FRONTIER_MODEL=
S1_IMPL=stub
S2_IMPL=stub
MEMORY_IMPL=mock
ENRICH_IMPL=data
